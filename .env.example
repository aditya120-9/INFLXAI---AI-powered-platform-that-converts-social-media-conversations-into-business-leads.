# AutoStream Configuration
# Copy this file to .env and fill in your actual values

# REQUIRED: Your Google AI API Key (get from https://aistudio.google.com/app/apikeys)
OPENAI_API_KEY=your_api_key_here
# OPTIONAL: Model selection (default: gemini-1.5-flash)
GENAI_MODEL=gemini-1.5-flash

# OPTIONAL: LLM Parameters for UI control
GENAI_TEMPERATURE=0.3
GENAI_MAX_OUTPUT_TOKENS=256

# OPTIONAL: Streamlit settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_LOGGER_LEVEL=info
